type Query {
    getAllPaginated(page: Int!, size: Int!): [Maintenance]
    getById(id: String!): Maintenance
}

type Maintenance {
    id: ID
    spareName: String
    RC: String
    issue: String
    brandModel: String
    price: Int
    currentKM: Float
    upcomingCheckUpKM: Float
    extraNotes: String
}
